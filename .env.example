# Server Configuration
PORT=8080
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chamachain

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRY_MINUTES=5

# App URLs
BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Security
ALLOWED_IPS=
ENABLE_BROWSER_ONLY=true
ENABLE_IP_WHITELIST=false

# Payment (M-Pesa)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379

# Bybit (Crypto)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_MAIN_WALLET=

# OCR (Google Cloud Vision)
GOOGLE_CLOUD_API_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
